+    // Only classify bounded DOS/COFF/optional-header fields here. The
+    // portable PE32 loader performs the complete validation before acceptance.
+    bool IsPe32Candidate(const BYTE* bytes, size_t size)
+    {
+        if (!bytes || size < 64 || bytes[0] != 'M' || bytes[1] != 'Z') return false;
+        DWORD ntOffset = 0;
+        std::memcpy(&ntOffset, bytes + 0x3c, sizeof(ntOffset));
+        if (ntOffset > size || size - ntOffset < 26) return false;
+        DWORD signature = 0;
+        WORD machine = 0;
+        WORD magic = 0;
+        std::memcpy(&signature, bytes + ntOffset, sizeof(signature));
+        std::memcpy(&machine, bytes + ntOffset + 4, sizeof(machine));
+        std::memcpy(&magic, bytes + ntOffset + 24, sizeof(magic));
+        return signature == IMAGE_NT_SIGNATURE && machine == IMAGE_FILE_MACHINE_I386 &&
+            magic == IMAGE_NT_OPTIONAL_HDR32_MAGIC;
+    }
+
+    std::wstring Pe32Text(const std::string& value)
+    {
+        std::wstring result;
+        result.reserve(value.size());
+        for (unsigned char character : value) result.push_back(static_cast<wchar_t>(character));
+        return result;
+    }
+
+    bool HasPe32HostAdapter(const xcdm::runtime::Pe32Import& symbol)
+    {
