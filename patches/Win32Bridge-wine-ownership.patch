+ImportResolution GuestModuleLoader::ResolveOwnedImport(
+    const ImportedSymbol& symbol, const ImportResolver& wineResolver) const
+{
+    const auto decision = m_ownership.Decide(symbol.library);
+    ImportedSymbol canonical = symbol;
+    if (m_ownership.IsStrict()) canonical.library = decision.canonicalName;
+    ImportResolution failure{};
+    failure.disposition = ImportDisposition::Unsupported;
+    failure.note = L"Module ownership rejected " + symbol.library + L": " + decision.reason;
+    ImportResolution resolution = xcdm::runtime::RouteModuleSymbol(decision,
+        [&] { return m_resolver(canonical); },
+        [&] { return wineResolver(canonical); },
+        [](const ImportResolution& value) { return value.targetAddress != 0; }, failure);
+    if (m_ownership.IsStrict() && resolution.targetAddress == 0)
+    {
+        const std::wstring owner = decision.owner == xcdm::runtime::ModuleOwner::Bridge
+            ? L"Bridge" : decision.owner == xcdm::runtime::ModuleOwner::Wine ? L"Wine" : L"Reject";
+        resolution.disposition = ImportDisposition::Unsupported;
+        resolution.note = L"Strict owner " + owner + L" could not resolve " + symbol.library + L"!" +
+            (symbol.importedByOrdinal ? L"#" + std::to_wstring(symbol.ordinal) : symbol.name) +
+            L". No cross-owner fallback is permitted. " + decision.reason;
+        RuntimeDiagnostics::Record(L"DLL OWNER MISSING: " + resolution.note);
+    }
+    return resolution;
+}
