<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
         IgnorableNamespaces="uap mp">
  <Identity Name="ProtonDesktop.Native" Publisher="CN=ProtonDesktopDev" Version="0.1.0.0" ProcessorArchitecture="x64" />
  <mp:PhoneIdentity PhoneProductId="9a8927d3-155d-4ebd-9c44-ca47b0721918" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties><DisplayName>ProtonDesktop</DisplayName><PublisherDisplayName>ProtonDesktop</PublisherDisplayName><Logo>Assets\StoreLogo.png</Logo></Properties>
  <Dependencies><TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" /></Dependencies>
  <Resources><Resource Language="en-US" /></Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="ProtonDesktop.App">
      <uap:VisualElements DisplayName="ProtonDesktop" Description="Native Boxedwine64 UWP port starter" BackgroundColor="#0B244A" Square150x150Logo="Assets\Logo150.png" Square44x44Logo="Assets\Logo44.png">
        <uap:DefaultTile Wide310x150Logo="Assets\WideLogo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0B244A" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities><Capability Name="privateNetworkClientServer" /></Capabilities>
</Package>
